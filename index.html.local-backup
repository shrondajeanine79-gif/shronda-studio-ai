
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#F5F0E1">
  <meta name="description" content="Shronda Studio AI — your creative workspace for content, branding, project planning, and website development.">
  <title>Shronda Studio AI</title>

  <style>
    :root {
      --cream: #F5F0E1;
      --teal: #3C6E71;
      --gold: #D4AF37;
      --rose: #C08473;
      --indigo: #2C2A4A;
      --sage: #A8B2A1;
      --white: #FFFEFA;
      --text: #292B2B;
      --muted: #686B67;
      --border: #DDD7C8;
      --soft-teal: #E9EDE5;
      --soft-gold: #FBF5DE;
      --danger: #9C3939;
    }

    * {
      box-sizing: border-box;
    }

    [hidden] {
      display: none !important;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--cream);
      color: var(--text);
      font-family: "Segoe UI", Arial, sans-serif;
    }

    button,
    textarea,
    input {
      font: inherit;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    button {
      cursor: pointer;
    }

    button:focus-visible,
    a:focus-visible,
    textarea:focus-visible {
      outline: 3px solid var(--gold);
      outline-offset: 3px;
    }

    a {
      color: inherit;
    }

    .app {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 250px minmax(0, 1fr);
    }

    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      padding: 28px 18px;
      background: var(--white);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 26px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .brand-mark {
      width: 43px;
      height: 43px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: var(--teal);
      color: var(--gold);
      font-size: 25px;
      font-weight: 700;
    }

    .brand-name {
      font-size: 16px;
      font-weight: 750;
      line-height: 1.3;
    }

    .brand-caption {
      color: var(--muted);
      font-size: 12px;
      margin-top: 3px;
    }

    .new-chat {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--teal);
      border-radius: 10px;
      background: var(--teal);
      color: white;
      font-weight: 650;
      transition: background 0.2s;
    }

    .new-chat:hover,
    .send:hover {
      background: #31595C;
    }

    .side-label {
      margin: 0 0 12px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .tool-link {
      display: block;
      width: 100%;
      margin-bottom: 7px;
      padding: 11px;
      border: 0;
      border-radius: 9px;
      background: transparent;
      color: var(--text);
      text-align: left;
      transition: background 0.2s;
    }

    .tool-link:hover,
    .tool-link.active {
      background: var(--soft-teal);
    }

    .sidebar-note {
      margin-top: auto;
      padding: 15px;
      border: 1px solid #E6D9AD;
      border-radius: 12px;
      background: var(--soft-gold);
      font-size: 13px;
      line-height: 1.5;
    }

    .sidebar-note strong {
      display: block;
      margin-bottom: 5px;
      color: var(--teal);
    }

    .main {
      min-width: 0;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 19px 30px;
      border-bottom: 1px solid var(--border);
      background: rgba(255, 254, 250, 0.96);
    }

    .topbar-title {
      font-size: 14px;
      font-weight: 650;
    }

    .status {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--muted);
      font-size: 12px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      flex-shrink: 0;
      border-radius: 50%;
      background: #4B8A62;
    }

    .status-dot.offline {
      background: var(--rose);
    }

    .workspace {
      width: 100%;
      max-width: 1000px;
      margin: 0 auto;
      padding: 52px 26px 28px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .welcome {
      margin-bottom: 32px;
    }

    .eyebrow {
      margin-bottom: 12px;
      color: var(--teal);
      font-size: 12px;
      font-weight: 750;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-size: clamp(32px, 5vw, 48px);
      letter-spacing: -1.5px;
      line-height: 1.15;
    }

    h1 span {
      color: var(--teal);
    }

    .intro {
      max-width: 620px;
      margin-top: 15px;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.7;
    }

    .suggestions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 26px;
    }

    .suggestion {
      min-height: 100px;
      padding: 17px;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: var(--white);
      color: var(--text);
      text-align: left;
      transition: border-color 0.2s, transform 0.2s;
    }

    .suggestion:hover {
      border-color: var(--teal);
      transform: translateY(-2px);
    }

    .suggestion strong {
      display: block;
      margin-bottom: 7px;
      color: var(--teal);
      font-size: 14px;
    }

    .suggestion span {
      display: block;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.5;
    }

    .conversation {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-bottom: 24px;
    }

    .message {
      padding: 17px 19px;
      border-radius: 14px;
      line-height: 1.7;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
    }

    .message.user {
      align-self: flex-end;
      max-width: 85%;
      background: var(--teal);
      color: white;
    }

    .message.assistant {
      align-self: stretch;
      background: var(--white);
      border: 1px solid var(--border);
    }

    .message.error {
      border-color: #D9A5A5;
      color: var(--danger);
    }

    .message-label {
      display: block;
      margin-bottom: 6px;
      font-size: 11px;
      font-weight: 750;
      letter-spacing: 1px;
      text-transform: uppercase;
      opacity: 0.8;
    }

    .composer {
      margin-top: auto;
      padding: 14px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--white);
      box-shadow: 0 8px 28px rgba(44, 42, 74, 0.05);
    }

    .prompt {
      width: 100%;
      min-height: 90px;
      max-height: 220px;
      resize: vertical;
      padding: 8px;
      border: 0;
      outline: none;
      background: transparent;
      color: var(--text);
      line-height: 1.6;
    }

    .composer-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding-top: 10px;
      border-top: 1px solid #EEE9DE;
    }

    .hint {
      color: var(--muted);
      font-size: 11px;
      line-height: 1.5;
    }

    .send {
      min-width: 100px;
      padding: 11px 17px;
      border: 0;
      border-radius: 10px;
      background: var(--teal);
      color: white;
      font-weight: 700;
    }

    .send:disabled {
      cursor: wait;
      opacity: 0.6;
    }

    /* Website Studio */

    .website-heading {
      margin-bottom: 28px;
    }

    .website-heading .intro {
      margin-bottom: 0;
    }

    .section-heading {
      margin: 26px 0 12px;
      color: var(--indigo);
      font-size: 16px;
      font-weight: 750;
    }

    .website-cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .website-card {
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 20px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--white);
    }

    .website-card-icon {
      width: 43px;
      height: 43px;
      display: grid;
      place-items: center;
      margin-bottom: 13px;
      border-radius: 12px;
      background: var(--soft-teal);
      color: var(--teal);
      font-size: 21px;
    }

    .website-card h2 {
      margin: 0 0 8px;
      font-size: 16px;
      line-height: 1.4;
    }

    .website-card p {
      flex: 1;
      margin: 0 0 17px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.7;
      overflow-wrap: anywhere;
    }

    .action-link,
    .secondary-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 41px;
      padding: 10px 13px;
      border: 1px solid var(--teal);
      border-radius: 9px;
      background: var(--teal);
      color: white;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.2s;
    }

    .action-link:hover,
    .secondary-button:hover {
      background: #31595C;
    }

    .secondary-button {
      background: var(--white);
      color: var(--teal);
    }

    .secondary-button:hover {
      background: var(--soft-teal);
      color: var(--teal);
    }

    .website-panel {
      margin-top: 24px;
      padding: 21px;
      border: 1px solid #E6D9AD;
      border-radius: 14px;
      background: var(--soft-gold);
    }

    .website-panel h2 {
      margin: 0 0 8px;
      color: var(--teal);
      font-size: 17px;
    }

    .website-panel p {
      margin: 0 0 15px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.7;
    }

    .website-panel-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .website-address {
      display: block;
      margin-top: 12px;
      color: var(--muted);
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    .back-button {
      align-self: flex-start;
      margin-top: 24px;
      padding: 10px 0;
      border: 0;
      background: transparent;
      color: var(--teal);
      font-size: 13px;
      font-weight: 700;
    }

    .back-button:hover {
      text-decoration: underline;
    }

    .footer {
      padding: 0 26px 22px;
      color: var(--muted);
      text-align: center;
      font-size: 11px;
      line-height: 1.6;
    }

    .footer strong {
      color: var(--teal);
    }

    .mobile-brand {
      display: none;
    }

    @media (max-width: 900px) {
      .app {
        grid-template-columns: 215px minmax(0, 1fr);
      }

      .sidebar {
        padding: 22px 13px;
      }

      .workspace {
        padding: 36px 20px 24px;
      }

      .topbar {
        padding: 16px 20px;
      }
    }

    @media (max-width: 720px) {
      .app {
        display: block;
      }

      .sidebar {
        position: static;
        height: auto;
        display: flex;
        padding: 12px 14px;
        border-right: 0;
        border-bottom: 1px solid var(--border);
        gap: 12px;
      }

      .sidebar .brand {
        margin-bottom: 2px;
      }

      .sidebar .brand-mark {
        width: 36px;
        height: 36px;
        border-radius: 11px;
      }

      .sidebar .new-chat {
        padding: 10px;
      }

      .sidebar > div:nth-of-type(2) {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
      }

      .side-label {
        width: 100%;
        margin-bottom: 4px;
      }

      .tool-link {
        width: auto;
        margin: 0;
        padding: 9px;
        font-size: 12px;
      }

      .sidebar-note {
        display: none;
      }

      .topbar {
        position: static;
        padding: 13px 17px;
      }

      .mobile-brand {
        display: block;
        font-weight: 750;
      }

      .topbar-title {
        display: none;
      }

      .workspace {
        padding: 32px 17px 22px;
      }

      .suggestions,
      .website-cards {
        grid-template-columns: 1fr;
      }

      .suggestion {
        min-height: auto;
      }

      .message.user {
        max-width: 95%;
      }

      .composer-footer {
        align-items: flex-end;
      }

      .hint {
        max-width: 65%;
      }

      .footer {
        padding: 0 17px 18px;
      }
    }

    @media (max-width: 390px) {
      .status {
        font-size: 10px;
      }

      .tool-link {
        font-size: 11px;
      }

      .website-panel-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .website-panel-actions > * {
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <div class="app">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">μ</div>
        <div>
          <div class="brand-name">Shronda Studio AI</div>
          <div class="brand-caption">Create with intention.</div>
        </div>
      </div>

      <button class="new-chat" id="newChat" type="button">
        + New conversation
      </button>

      <div>
        <p class="side-label">Your creative studio</p>

        <button class="tool-link active" data-prompt="Help me brainstorm a new idea." type="button">
          ✧ Idea Lab
        </button>

        <button class="tool-link" data-prompt="Help me write an engaging social media post in a natural, direct voice." type="button">
          ✎ Content Creation
        </button>

        <button class="tool-link" data-prompt="Help me develop my brand voice and messaging." type="button">
          ◇ Brand Development
        </button>

        <button class="tool-link" data-prompt="Help me organize a project into clear, manageable steps." type="button">
          ▦ Project Planning
        </button>

        <button class="tool-link" id="websiteTool" type="button" aria-controls="websiteWorkspace">
          🌿 Website Studio
        </button>
      </div>

      <div class="sidebar-note">
        <strong>Make room for your ideas.</strong>
        Start with what you have. Build one step at a time.
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div class="mobile-brand">μ Shronda Studio AI</div>
        <div class="topbar-title" id="topbarTitle">Your creative workspace</div>

        <div class="status" id="serviceStatus">
          <span class="status-dot" id="statusDot"></span>
          <span id="statusText">AI service configured</span>
        </div>
      </header>

      <section class="workspace">
        <!-- Main creative workspace -->
        <section id="creativeWorkspace">
          <div class="welcome" id="welcome">
            <div class="eyebrow">On purpose. With purpose.</div>

            <h1>Your ideas deserve<br><span>room to grow.</span></h1>

            <p class="intro">
              Welcome to Shronda Studio AI. Bring your ideas, questions,
              drafts, and plans. Let's turn them into something useful.
            </p>
          </div>

          <div class="suggestions" id="suggestions">
            <button class="suggestion" data-prompt="Give me five fresh content ideas for On Purpose With Purpose." type="button">
              <strong>✧ Brainstorm ideas</strong>
              <span>Find a fresh angle for your next project or post.</span>
            </button>

            <button class="suggestion" data-prompt="Help me write a social media post that sounds natural, direct, and human." type="button">
              <strong>✎ Create content</strong>
              <span>Draft a post, caption, script, or blog outline.</span>
            </button>

            <button class="suggestion" data-prompt="Help me organize a project into a practical step-by-step action plan." type="button">
              <strong>▦ Organize a project</strong>
              <span>Break a big idea into achievable next steps.</span>
            </button>

            <button class="suggestion" data-prompt="Help me strengthen my brand messaging and keep it consistent." type="button">
              <strong>◇ Develop my brand</strong>
              <span>Clarify your message, audience, and creative direction.</span>
            </button>
          </div>

          <div class="conversation" id="conversation" aria-live="polite"></div>

          <form class="composer" id="chatForm">
            <textarea
              class="prompt"
              id="prompt"
              maxlength="10000"
              placeholder="What would you like to create today?"
              aria-label="Your message"
              required
            ></textarea>

            <div class="composer-footer">
              <span class="hint">Enter to send · Shift + Enter for a new line</span>
              <button class="send" id="sendButton" type="submit">Send ↗</button>
            </div>
          </form>
        </section>

        <!-- Website workspace -->
        <section id="websiteWorkspace" hidden>
          <div class="website-heading">
            <div class="eyebrow">Your digital home</div>

            <h1>Website Studio<br><span>build with intention.</span></h1>

            <p class="intro">
              Work on the On Purpose With Purpose website from your
              creative workspace. Open the live site, access your source
              files, or ask the AI to help plan your next website update.
            </p>
          </div>

          <h2 class="section-heading">Your website</h2>

          <div class="website-cards">
            <article class="website-card">
              <div class="website-card-icon" aria-hidden="true">↗</div>
              <h2>Live website</h2>
              <p>
                Visit the published website to review its current appearance,
                content, links, and visitor experience.
              </p>
              <a
                class="action-link"
                href="https://shrondajeanineco.com"
                target="_blank"
                rel="noopener noreferrer"
              >
                Open live website ↗
              </a>
              <span class="website-address">shrondajeanineco.com</span>
            </article>

            <article class="website-card">
              <div class="website-card-icon" aria-hidden="true">⌘</div>
              <h2>Website source files</h2>
              <p>
                Open your GitHub repository to review the website files,
                changes, commit history, and project structure.
              </p>
              <a
                class="action-link"
                href="https://github.com/shrondajeanine79-gif/on-purpose-with-purpose"
                target="_blank"
                rel="noopener noreferrer"
              >
                Open GitHub repository ↗
              </a>
              <span class="website-address">
                on-purpose-with-purpose
              </span>
            </article>
          </div>

          <div class="website-panel">
            <h2>What would you like to work on?</h2>

            <p>
              Start with a specific website task. Shronda Studio AI can
              help draft page content, create code, troubleshoot errors,
              improve layout, and organize the next development steps.
            </p>

            <div class="website-panel-actions">
              <button class="secondary-button" id="websiteContent" type="button">
                Write website content
              </button>

              <button class="secondary-button" id="websiteDesign" type="button">
                Improve website design
              </button>

              <button class="secondary-button" id="websiteCode" type="button">
                Help with website code
              </button>
            </div>

            <span class="website-address">
              Local project folder: C:\Projects\on-purpose-with-purpose
            </span>
          </div>

          <button class="back-button" id="backToStudio" type="button">
            ← Back to creative studio
          </button>
        </section>
      </section>

      <footer class="footer">
        <strong>Shronda Studio AI</strong> · Built for ideas with intention.<br>
        AI responses can make mistakes. Review important information before using it.
      </footer>
    </main>
  </div>

  <script>
    /*
      The AI service URL remains the deployed Rust backend.
      Website links open the existing live site and GitHub repository.
    */
    const API_URL = "https://shronda-studio-ai.onrender.com/api/chat";

    const form = document.getElementById("chatForm");
    const promptInput = document.getElementById("prompt");
    const sendButton = document.getElementById("sendButton");
    const conversation = document.getElementById("conversation");
    const welcome = document.getElementById("welcome");
    const suggestions = document.getElementById("suggestions");
    const newChatButton = document.getElementById("newChat");

    const creativeWorkspace = document.getElementById("creativeWorkspace");
    const websiteWorkspace = document.getElementById("websiteWorkspace");
    const websiteTool = document.getElementById("websiteTool");
    const backToStudio = document.getElementById("backToStudio");
    const topbarTitle = document.getElementById("topbarTitle");

    const statusDot = document.getElementById("statusDot");
    const statusText = document.getElementById("statusText");

    let requestInProgress = false;

    function setServiceStatus(message, isOffline = false) {
      statusText.textContent = message;
      statusDot.classList.toggle("offline", isOffline);
    }

    function showCreativeWorkspace() {
      websiteWorkspace.hidden = true;
      creativeWorkspace.hidden = false;
      websiteTool.classList.remove("active");
      topbarTitle.textContent = "Your creative workspace";

      promptInput.focus();
    }

    function showWebsiteWorkspace() {
      creativeWorkspace.hidden = true;
      websiteWorkspace.hidden = false;
      websiteTool.classList.add("active");
      topbarTitle.textContent = "Website Studio";
    }

    function addMessage(label, text, type) {
      const message = document.createElement("div");
      message.className = `message ${type}`;

      const heading = document.createElement("span");
      heading.className = "message-label";
      heading.textContent = label;

      const content = document.createElement("div");
      content.textContent = text;

      message.append(heading, content);
      conversation.appendChild(message);

      message.scrollIntoView({
        behavior: "smooth",
        block: "nearest"
      });

      return {
        message,
        content
      };
    }

    async function sendPrompt(prompt) {
      const cleanPrompt = prompt.trim();

      if (!cleanPrompt || requestInProgress) {
        return;
      }

      showCreativeWorkspace();

      welcome.hidden = true;
      suggestions.hidden = true;

      addMessage("You", cleanPrompt, "user");

      promptInput.value = "";
      requestInProgress = true;
      sendButton.disabled = true;
      sendButton.textContent = "Thinking…";

      const assistantMessage = addMessage(
        "Shronda Studio AI",
        "Working on your response…",
        "assistant"
      );

      try {
        const response = await fetch(API_URL, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            prompt: cleanPrompt
          })
        });

        let data;

        try {
          data = await response.json();
        } catch {
          throw new Error(
            "The AI service returned an unreadable response."
          );
        }

        if (!response.ok) {
          throw new Error(
            data.error || `Request failed (${response.status}).`
          );
        }

        assistantMessage.content.textContent =
          typeof data.answer === "string" && data.answer.trim()
            ? data.answer
            : "The AI returned an empty response.";

        setServiceStatus("AI response received");
      } catch (error) {
        assistantMessage.message.classList.add("error");

        assistantMessage.content.textContent =
          "I couldn't complete that request.\n\n" +
          (error.message || "Please try again.") +
          "\n\nIf the service has been inactive, wait a minute and try again.";

        setServiceStatus("AI service needs attention", true);
      } finally {
        requestInProgress = false;
        sendButton.disabled = false;
        sendButton.textContent = "Send ↗";
        promptInput.focus();
      }
    }

    function prepareWebsitePrompt(prompt) {
      showCreativeWorkspace();

      welcome.hidden = true;
      suggestions.hidden = true;

      promptInput.value = prompt;
      promptInput.focus();

      promptInput.scrollIntoView({
        behavior: "smooth",
        block: "center"
      });
    }

    // Send a message to the AI.
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      sendPrompt(promptInput.value);
    });

    // Enter sends; Shift + Enter inserts a line break.
    promptInput.addEventListener("keydown", (event) => {
      if (
        event.key === "Enter" &&
        !event.shiftKey &&
        !event.isComposing
      ) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    // Creative tool buttons.
    document.querySelectorAll("[data-prompt]").forEach((button) => {
      button.addEventListener("click", () => {
        showCreativeWorkspace();
        promptInput.value = button.dataset.prompt;
        promptInput.focus();
      });
    });

    // Open Website Studio.
    websiteTool.addEventListener("click", showWebsiteWorkspace);

    // Return from Website Studio.
    backToStudio.addEventListener("click", showCreativeWorkspace);

    // Website tasks prepare prompts in the existing AI chat.
    document.getElementById("websiteContent").addEventListener("click", () => {
      prepareWebsitePrompt(
        "Help me write or improve content for the On Purpose With Purpose website at shrondajeanineco.com. " +
        "Keep the writing direct, natural, human, and consistent with my brand. " +
        "Give me the complete proposed content and identify which website page it belongs on."
      );
    });

    document.getElementById("websiteDesign").addEventListener("click", () => {
      prepareWebsitePrompt(
        "Help me improve the design of the On Purpose With Purpose website. " +
        "My local project folder is C:\\Projects\\on-purpose-with-purpose. " +
        "Keep the existing brand identity, use a cream or off-white background, " +
        "and use teal, sky blue, purple, silver, gold, and complementary brand colors as accents. " +
        "Give me complete replacement code for one file at a time and explain how to test it."
      );
    });

    document.getElementById("websiteCode").addEventListener("click", () => {
      prepareWebsitePrompt(
        "Help me develop and troubleshoot the On Purpose With Purpose website. " +
        "The local project folder is C:\\Projects\\on-purpose-with-purpose. " +
        "I use Windows and GitHub. I want beginner-friendly steps, complete replacement code " +
        "for one file at a time, and a test before each commit. " +
        "First ask me for the current file or error you need to inspect. " +
        "Do not assume you can access my local files directly."
      );
    });

    // Reset the conversation and return to the main workspace.
    newChatButton.addEventListener("click", () => {
      conversation.replaceChildren();

      welcome.hidden = false;
      suggestions.hidden = false;
      promptInput.value = "";

      showCreativeWorkspace();
    });

    // The configured endpoint is shown without claiming it has been tested.
    setServiceStatus("AI service configured");
  </script>
</body>
</html>
